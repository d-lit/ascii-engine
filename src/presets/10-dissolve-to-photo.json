{
  "version": 1,
  "name": "Dissolve to photo",
  "ramp": "classic",
  "polarity": "light-on-dark",
  "color": { "mode": "mono" },
  "backdrop": { "kind": "image", "origin": "picture", "fit": "grid", "opacity": 1, "dim": 0.15, "blur": 0 },
  "chain": [
    {
      "effect": "erosion",
      "params": {
        "threshold": { "env": [[0, 0], [1.5, 0], [5, 0.9], [7, 0.9], [10.5, 0]], "loop": true, "ease": "smooth" },
        "softness": 0.15,
        "scale": 16,
        "speed": 0.12,
        "mode": "hide"
      }
    }
  ]
}
