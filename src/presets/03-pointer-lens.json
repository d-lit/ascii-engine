{
  "version": 1,
  "name": "Pointer lens",
  "ramp": "classic",
  "polarity": "dark-on-light",
  "color": { "mode": "mono" },
  "chain": [
    {
      "effect": "swirl",
      "params": { "center": "center", "angle": 120, "radius": 45, "wobble": 0.12 }
    },
    {
      "effect": "lens",
      "params": {
        "center": "pointer",
        "radius": 20,
        "strength": { "lfo": "triangle", "freq": 0.25, "min": 0.2, "max": 0.6 }
      }
    },
    {
      "effect": "pulse",
      "params": { "shape": "radial", "center": "pointer", "amount": 0.3, "radius": 18 },
      "mask": { "type": "radial", "center": "pointer", "radius": 22, "soft": 6 }
    }
  ]
}
